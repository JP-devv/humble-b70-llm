+# Host-staged collectives for XPU TP on hosts where cross-device VRAM IPC is
+# unavailable (GPUs on separate PCIe root ports: zeMemOpenIpcHandle fails with
+# ZE_RESULT_ERROR_INVALID_ARGUMENT for cross-device handles). Payloads at or
+# above VLLM_XPU_HOST_STAGED_MIN_BYTES are bounced through pinned host memory
+# over the CPU (gloo) group; small payloads stay on the native device path.
+_HOST_STAGED = os.environ.get("VLLM_XPU_HOST_STAGED_COLLECTIVES", "0") == "1"
+_HOST_STAGED_MIN_BYTES = int(
+    os.environ.get("VLLM_XPU_HOST_STAGED_MIN_BYTES", str(1 * 1024 * 1024))
+)
+
+# VLLM_XPU_STAGE_TIMING=1: cumulative host-side wall-time stats for the
+# host-staged collective path (perf_counter around each blocking phase).
+# Host-side only: no tensor .item(), no stream sync, so decode graph capture
+# (sizes 1-8) is unaffected. Drained once per engine step by
+# gpu_model_runner's VLLM_XPU_STEP_TIMING channel.
+_STAGE_TIMING = os.environ.get("VLLM_XPU_STAGE_TIMING", "0") == "1"
+
+
+class _StageTimingStats:
+    __slots__ = ("calls", "bytes_moved", "d2h_ms", "gloo_ms", "h2d_ms")
+
+    def __init__(self):
+        self.calls = 0
+        self.bytes_moved = 0
+        self.d2h_ms = 0.0
+        self.gloo_ms = 0.0
+        self.h2d_ms = 0.0
+
+    def add(self, nbytes: int, d2h_ms: float, gloo_ms: float,
+            h2d_ms: float) -> None:
+        self.calls += 1
+        self.bytes_moved += nbytes
+        self.d2h_ms += d2h_ms
+        self.gloo_ms += gloo_ms
+        self.h2d_ms += h2d_ms
+
+    def add_phases(self, d2h_ms: float, gloo_ms: float,
+                   h2d_ms: float) -> None:
+        """Phase-only accumulation from the slice worker thread (calls/bytes
+        are counted once per collective on the engine thread)."""
+        self.d2h_ms += d2h_ms
+        self.gloo_ms += gloo_ms
+        self.h2d_ms += h2d_ms
+
+    def reset(self) -> None:
+        self.calls = 0
+        self.bytes_moved = 0
+        self.d2h_ms = 0.0
+        self.gloo_ms = 0.0
+        self.h2d_ms = 0.0
+
+
+_STAGE_STATS = _StageTimingStats()
+
+
+def get_and_reset_stage_stats() -> tuple[int, int, float, float, float]:
+    """Return (calls, bytes_moved, d2h_ms, gloo_ms, h2d_ms) since the last
+    drain and reset. Engine-thread only; no synchronization."""
+    s = _STAGE_STATS
+    out = (s.calls, s.bytes_moved, s.d2h_ms, s.gloo_ms, s.h2d_ms)
+    s.reset()
+    return out
+
+
+# VLLM_XPU_STAGE_SLICE_KB > 0: sliced pipelined staging for host-staged
+# all_reduce (bigPP L1). Each staged all_reduce is split into ~SLICE_KB
+# slices; D2H slice copies are enqueued async with one event per slice, a
+# dedicated worker thread runs the CPU reduce for each slice as its D2H
+# lands, and the engine enqueues each H2D slice as its reduce completes.
+# The engine still host-blocks per slice, but the GPU copy engine no
+# longer idles behind the CPU reduce: wall per collective goes from
+# (D2H + reduce + H2D) toward max(D2H + H2D, reduce) + tails.
+# Correctness: all_reduce is elementwise, so slices are independent; the
+# engine returns only after every H2D is enqueued, keeping consumers
+# stream-ordered exactly as in the blocking path; gloo collectives for
+# one staged all_reduce fully complete before the engine issues anything
+# else on the CPU group, so gloo call ordering across ranks is unchanged.
+# Never runs under decode graph capture (staging only triggers at >= 1 MB
+# payloads, and the graph-captured MTP path routes through the functional
+# wrappers, not this method).
+_STAGE_SLICE_KB = int(os.environ.get("VLLM_XPU_STAGE_SLICE_KB", "0"))
+
+# VLLM_XPU_STAGE_SHM=1: run the per-slice CPU reduce as a 2-rank
+# shared-memory exchange (/dev/shm regions + spin barriers + numpy add)
+# instead of gloo's loopback TCP (~4.6 GB/s measured on the reference
+# host). 2-rank groups only; anything else falls back to gloo. Only used
+# by the sliced path (the segment is sized to one slice).
+_STAGE_SHM = os.environ.get("VLLM_XPU_STAGE_SHM", "0") == "1"
+
+
+class _ShmPair:
+    """Two-rank shared-memory all_reduce for the sliced staged path.
+
+    Segment layout: [4 KiB control][region rank0][region rank1], each
+    region cap_bytes. Exchange with sequence number s: each rank copies
+    its slice into its own region, releases rdy[me]=s, spins for
+    rdy[peer]>=s, adds both regions into the destination (torch CPU add
+    on frombuffer views), releases ack[me]=s, and spins for ack[peer]>=s
+    so no region is overwritten while the peer is still reading. At most
+    one slice of skew between ranks. The add is elementwise and
+    bit-identical to gloo's 2-rank sum (verified in the regression pack).
+    """
+
+    _CTRL = 4096
+    _SPIN_TIMEOUT_S = 60.0
+
+    def __init__(self, cpu_group: ProcessGroup, rank: int, cap_bytes: int):
+        import uuid
+        from multiprocessing import resource_tracker, shared_memory
+
+        import numpy as np
+
+        self._rank = rank
+        self._cap = cap_bytes
+        # Rendezvous on a per-boot random name over the (already up) gloo
+        # group so stale segments from crashed runs can never collide.
+        if rank == 0:
+            tok = torch.tensor(
+                bytearray(uuid.uuid4().hex[:16], "utf-8"), dtype=torch.uint8
+            )
+        else:
+            tok = torch.empty(16, dtype=torch.uint8)
+        dist.broadcast(tok, src=0, group=cpu_group)
+        name = "vllm-stage-" + bytes(tok.tolist()).decode()
+        size = self._CTRL + 2 * cap_bytes
+        if rank == 0:
+            self._gc_stale()
+            self._shm = shared_memory.SharedMemory(
+                name=name, create=True, size=size
+            )
+            np.frombuffer(self._shm.buf, dtype=np.int64,
+                          count=self._CTRL // 8)[:] = 0
+        else:
+            self._shm = None
+            for _ in range(6000):
+                try:
+                    self._shm = shared_memory.SharedMemory(
+                        name=name, create=False
+                    )
+                    break
+                except FileNotFoundError:
+                    time.sleep(0.01)
+            if self._shm is None:
+                raise RuntimeError(
+                    "timed out waiting for shm segment " + name
+                )
+            # The creator owns unlink(); keep the tracker's atexit hook
+            # from unlinking someone else's segment.
+            resource_tracker.unregister(self._shm._name, "shared_memory")
+        ctrl = np.frombuffer(self._shm.buf, dtype=np.int64,
+                             count=self._CTRL // 8)
+        # cache-line separated control words
+        self._rdy = (ctrl[0:1], ctrl[8:9])
+        self._ack = (ctrl[16:17], ctrl[24:25])
+        self._seq = 0
+        self._owner = rank == 0
+        import atexit
+
+        atexit.register(self._cleanup)
+
+    def _gc_stale(self):
+        # Best-effort cleanup of segments leaked by crashed runs
+        # (>1 h old). Only ever called by a rank0 creator.
+        import glob
+
+        now = time.time()
+        for path in glob.glob("/dev/shm/vllm-stage-*"):
+            try:
+                if now - os.path.getmtime(path) > 3600:
+                    os.unlink(path)
+            except OSError:
+                pass
+
+    def _cleanup(self):
+        # Views into the buffer live for the process lifetime, so close()
+        # would raise BufferError; the kernel reclaims the mapping at
+        # exit. The owner just unlinks the name.
+        if self._owner:
+            try:
+                os.unlink("/dev/shm/" + self._shm.name)
+            except OSError:
+                pass
+
+    def _region(self, who: int, dtype, nbytes: int) -> torch.Tensor:
+        off = self._CTRL + who * self._cap
+        return torch.frombuffer(
+            self._shm.buf[off:off + nbytes], dtype=dtype
+        )
+
+    def _spin(self, word, seq: int) -> None:
+        deadline = time.monotonic() + self._SPIN_TIMEOUT_S
+        n = 0
+        while word[0] < seq:
+            n += 1
+            if n & 0x3F == 0:
+                time.sleep(0)  # yield the GIL to the engine thread
+                if time.monotonic() > deadline:
+                    raise RuntimeError(
+                        "shm staged reduce: peer barrier timeout"
+                    )
+
+    def reduce(self, t: torch.Tensor) -> bool:
+        """In-place 2-rank sum; False if unsupported (caller falls back
+        to gloo)."""
+        nbytes = t.numel() * t.element_size()
+        if nbytes > self._cap:
+            return False
+        me = self._rank
+        peer = 1 - me
+        self._seq += 1
+        s = self._seq
+        # torch CPU add on frombuffer views: vectorized half arithmetic,
+        # ~5x faster than numpy fp16 add, and measured bit-identical to
+        # both numpy's fp16 add and gloo's 2-rank sum (all compute the
+        # same per-element float-upcast + round-to-nearest-even).
+        #
+        # inference_mode: `t` is a slice of the pinned staging buffer,
+        # which is allocated during the model forward — under vLLM's
+        # inference_mode — making it an inference tensor. The worker
+        # thread runs outside inference mode, where inplace updates of
+        # inference tensors raise. Re-enter it here.
+        with torch.inference_mode():
+            self._region(me, t.dtype, nbytes).copy_(t)
+            self._rdy[me][0] = s
+            self._spin(self._rdy[peer], s)
+            torch.add(
+                self._region(0, t.dtype, nbytes),
+                self._region(1, t.dtype, nbytes),
+                out=t,
+            )
+        self._ack[me][0] = s
+        self._spin(self._ack[peer], s)
+        return True
+
 
